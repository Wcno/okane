# Copy this file to .env before running `docker compose up`.
# The values below are placeholders for local development only: replace every
# secret before exposing the system to anyone else, and never commit .env.

# Address and port where webapp listens on this machine. No other container
# publishes a port. 127.0.0.1 keeps the system private to this computer; use
# 0.0.0.0 to reach it from other devices, after replacing the secrets below.
WEBAPP_BIND=127.0.0.1
WEBAPP_PORT=8000

# Host names webapp answers to, comma separated. Keep 127.0.0.1: the container
# health check uses it.
WEBAPP_ALLOWED_HOSTS=localhost,127.0.0.1

# Django secret keys. Use a different long random value for each service.
WEBAPP_SECRET_KEY=replace-with-a-long-random-value-for-webapp
API_SERVICE_SECRET_KEY=replace-with-a-long-random-value-for-api-service

# Days a session lasts without use; each request starts the count again.
SESSION_IDLE_DAYS=14

# Minutes a password reset link works after it is mailed.
PASSWORD_RESET_MINUTES=60

# Origin people open Okane on. Password reset links are built on it, never on
# a request header. Leave it unset for http://localhost:WEBAPP_PORT; set it
# when Okane is reached under another name, for example https://okane.example.
# WEBAPP_PUBLIC_ORIGIN=https://okane.example

# Mail server for password reset messages. While EMAIL_HOST is empty, each
# message is printed in the webapp log instead of being sent:
# `docker compose logs webapp` shows it, with its reset link.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=Okane <no-reply@localhost>

# Set to true when webapp is served over HTTPS. HTTPS requires a reverse
# proxy in front of webapp that terminates TLS, forwards the Host header and
# sets X-Forwarded-Proto, replacing any value the client sent. webapp then
# trusts that header and sends session and CSRF cookies only over HTTPS.
# Keep false for http://localhost.
WEBAPP_HTTPS=false

# Shared credential that webapp adds to every request it forwards.
# api-service rejects any financial request without it.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-key

# Passwords of the two PostgreSQL databases.
WEBAPP_DB_PASSWORD=replace-with-the-webapp-db-password
API_DB_PASSWORD=replace-with-the-api-db-password
